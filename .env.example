# =============================================================================
#  VARIABLES DE ENTORNO — Turismo Antuco
# =============================================================================
# Copia este archivo a ".env.local" y completa los valores reales.
# NUNCA subas ".env.local" al repositorio (ya está en .gitignore).
# =============================================================================

# --- Sanity (públicas: se envían al navegador, no son secretas) ---------------
# Las encuentras en https://www.sanity.io/manage → tu proyecto.
NEXT_PUBLIC_SANITY_PROJECT_ID="tu_project_id"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2024-10-01"

# --- Token de LECTURA (servidor) ----------------------------------------------
# Permiso "Viewer". Se usa para leer borradores en la vista previa.
# NO tiene permisos de escritura.
SANITY_API_READ_TOKEN="tu_token_de_lectura"

# --- Token de ESCRITURA (servidor, SECRETO) -----------------------------------
# Permiso "Editor". Lo usa SOLO el servidor para:
#   - el formulario "Publica tu servicio" (crea prestadores en borrador)
#   - el script de datos semilla (npm run seed)
# ¡Jamás debe llegar al navegador! No lleva prefijo NEXT_PUBLIC_.
SANITY_API_WRITE_TOKEN="tu_token_de_escritura"

# --- Secreto del webhook de revalidación --------------------------------------
# Cadena aleatoria que compartes entre Sanity y este sitio para validar
# que el webhook de revalidación es legítimo. Invéntala (p. ej. 32 caracteres).
SANITY_REVALIDATE_SECRET="una_cadena_secreta_aleatoria"

# --- URL pública del sitio (para SEO, sitemap, Open Graph, QR) -----------------
# En local: http://localhost:3000 · En producción: https://www.turismoantuco.cl
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- AccuWeather (pronóstico del tiempo, servidor, SECRETO) --------------------
# API key del plan gratuito de AccuWeather (https://developer.accuweather.com).
# Solo la usa el servidor; el pronóstico se cachea ~3 h para respetar el límite
# de llamadas diarias. Si la dejas vacía, el sitio funciona igual pero no
# muestra el pronóstico.
ACCUWEATHER_API_KEY=""

# (Opcional) Clave de localidad de AccuWeather para Antuco. Si la dejas vacía,
# se resuelve automáticamente por las coordenadas de Antuco y se cachea.
# Para obtenerla manualmente:  npm run accuweather:location
ACCUWEATHER_LOCATION_KEY=""
